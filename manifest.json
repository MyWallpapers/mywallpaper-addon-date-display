{
  "runtime": "canvas-v1",
  "name": "Date Display",
  "description": "Displays a localized date, weekday and optional clock with flexible typography and appearance controls.",
  "version": "3.0.3",
  "entry": "dist/assets/addon.js",
  "thumbnail": "assets/thumbnail.png",
  "deviceSettingsVersion": "1",
  "ui": {
    "pointerEvents": "none"
  },
  "settings": [
    {
      "id": "content",
      "type": "section",
      "label": "Content"
    },
    {
      "id": "showDayOfWeek",
      "type": "boolean",
      "label": "Weekday",
      "parent": "content",
      "scope": "layer",
      "default": true
    },
    {
      "id": "showDate",
      "type": "boolean",
      "label": "Date",
      "parent": "content",
      "scope": "layer",
      "default": true
    },
    {
      "id": "dateFormat",
      "type": "select",
      "label": "Date format",
      "parent": "content",
      "scope": "layer",
      "default": "long",
      "showIf": { "setting": "showDate", "equals": true },
      "options": [
        { "label": "Full", "value": "full" },
        { "label": "Long", "value": "long" },
        { "label": "Medium", "value": "medium" },
        { "label": "Short", "value": "short" },
        { "label": "ISO (2026-08-03)", "value": "iso" }
      ]
    },
    {
      "id": "showTime",
      "type": "boolean",
      "label": "Time",
      "parent": "content",
      "scope": "layer",
      "default": false
    },
    {
      "id": "timeFormat",
      "type": "select",
      "label": "Clock format",
      "parent": "content",
      "scope": "layer",
      "default": "24h",
      "showIf": { "setting": "showTime", "equals": true },
      "options": [
        { "label": "24 hour", "value": "24h" },
        { "label": "12 hour", "value": "12h" }
      ]
    },
    {
      "id": "showSeconds",
      "type": "boolean",
      "label": "Show seconds",
      "parent": "content",
      "scope": "layer",
      "default": false,
      "showIf": { "setting": "showTime", "equals": true }
    },
    {
      "id": "language",
      "type": "section",
      "label": "Language"
    },
    {
      "id": "locale",
      "type": "select",
      "label": "Locale",
      "description": "System follows the Windows language exposed by the browser.",
      "parent": "language",
      "scope": "layer",
      "default": "system",
      "options": [
        { "label": "System", "value": "system" },
        { "label": "English", "value": "en-US" },
        { "label": "Français", "value": "fr-FR" },
        { "label": "Deutsch", "value": "de-DE" },
        { "label": "Español", "value": "es-ES" },
        { "label": "Italiano", "value": "it-IT" },
        { "label": "Português", "value": "pt-BR" },
        { "label": "日本語", "value": "ja-JP" },
        { "label": "한국어", "value": "ko-KR" },
        { "label": "中文", "value": "zh-CN" },
        { "label": "Русский", "value": "ru-RU" },
        { "label": "العربية", "value": "ar" }
      ]
    },
    {
      "id": "customNames",
      "type": "section",
      "label": "Custom names",
      "description": "Optional replacements for the localized weekday and month names.",
      "parent": "language",
      "defaultCollapsed": true
    },
    {
      "id": "useCustomNames",
      "type": "boolean",
      "label": "Use custom names",
      "parent": "customNames",
      "scope": "layer",
      "default": false
    },
    {
      "id": "customDays",
      "type": "textarea",
      "label": "Weekdays",
      "description": "Seven comma-separated names, Sunday first.",
      "parent": "customNames",
      "scope": "layer",
      "default": "Sunday,Monday,Tuesday,Wednesday,Thursday,Friday,Saturday",
      "showIf": { "setting": "useCustomNames", "equals": true }
    },
    {
      "id": "customMonths",
      "type": "textarea",
      "label": "Months",
      "description": "Twelve comma-separated names, January first.",
      "parent": "customNames",
      "scope": "layer",
      "default": "January,February,March,April,May,June,July,August,September,October,November,December",
      "showIf": { "setting": "useCustomNames", "equals": true }
    },
    {
      "id": "typography",
      "type": "section",
      "label": "Typography"
    },
    {
      "id": "fontSource",
      "type": "select",
      "label": "Font source",
      "parent": "typography",
      "scope": "layer",
      "default": "system",
      "options": [
        { "label": "Installed font", "value": "system" },
        { "label": "Remote font", "value": "remote" }
      ]
    },
    {
      "id": "fontFamily",
      "type": "string",
      "label": "Font family",
      "description": "For example Segoe UI, Inter or Georgia.",
      "parent": "typography",
      "scope": "layer",
      "default": "Segoe UI"
    },
    {
      "id": "fontUrl",
      "type": "string",
      "label": "Font stylesheet or file URL",
      "parent": "typography",
      "scope": "layer",
      "default": "",
      "placeholder": "https://fonts.googleapis.com/css2?family=Inter",
      "showIf": { "setting": "fontSource", "equals": "remote" }
    },
    {
      "id": "fontWeight",
      "type": "select",
      "label": "Weight",
      "parent": "typography",
      "scope": "layer",
      "default": "600",
      "options": [
        { "label": "Light", "value": "300" },
        { "label": "Regular", "value": "400" },
        { "label": "Medium", "value": "500" },
        { "label": "Semibold", "value": "600" },
        { "label": "Bold", "value": "700" },
        { "label": "Black", "value": "900" }
      ]
    },
    {
      "id": "alignment",
      "type": "select",
      "label": "Alignment",
      "parent": "typography",
      "scope": "layer",
      "default": "center",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Center", "value": "center" },
        { "label": "Right", "value": "right" }
      ]
    },
    {
      "id": "textTransform",
      "type": "select",
      "label": "Letter case",
      "parent": "typography",
      "scope": "layer",
      "default": "none",
      "options": [
        { "label": "Original", "value": "none" },
        { "label": "Uppercase", "value": "uppercase" },
        { "label": "Lowercase", "value": "lowercase" },
        { "label": "Capitalize", "value": "capitalize" }
      ]
    },
    {
      "id": "dayFontSize",
      "type": "range",
      "label": "Weekday size",
      "parent": "typography",
      "scope": "layer",
      "default": 42,
      "min": 8,
      "max": 160,
      "step": 1
    },
    {
      "id": "dateFontSize",
      "type": "range",
      "label": "Date size",
      "parent": "typography",
      "scope": "layer",
      "default": 64,
      "min": 8,
      "max": 200,
      "step": 1
    },
    {
      "id": "timeFontSize",
      "type": "range",
      "label": "Time size",
      "parent": "typography",
      "scope": "layer",
      "default": 52,
      "min": 8,
      "max": 200,
      "step": 1,
      "showIf": { "setting": "showTime", "equals": true }
    },
    {
      "id": "letterSpacing",
      "type": "range",
      "label": "Letter spacing",
      "parent": "typography",
      "scope": "layer",
      "default": 1,
      "min": -4,
      "max": 30,
      "step": 0.5
    },
    {
      "id": "appearance",
      "type": "section",
      "label": "Appearance"
    },
    {
      "id": "primaryColor",
      "type": "color",
      "label": "Primary text",
      "parent": "appearance",
      "scope": "layer",
      "default": "#ffffff"
    },
    {
      "id": "secondaryColor",
      "type": "color",
      "label": "Secondary text",
      "parent": "appearance",
      "scope": "layer",
      "default": "#b9c3d6"
    },
    {
      "id": "opacity",
      "type": "range",
      "label": "Text opacity",
      "parent": "appearance",
      "scope": "layer",
      "default": 100,
      "min": 10,
      "max": 100,
      "step": 1
    },
    {
      "id": "shadowStrength",
      "type": "range",
      "label": "Shadow strength",
      "parent": "appearance",
      "scope": "layer",
      "default": 35,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "shadowColor",
      "type": "color",
      "label": "Shadow color",
      "parent": "appearance",
      "scope": "layer",
      "default": "#000000"
    },
    {
      "id": "backgroundColor",
      "type": "color",
      "label": "Background",
      "parent": "appearance",
      "scope": "layer",
      "alpha": true,
      "default": "#00000000"
    },
    {
      "id": "backgroundBlur",
      "type": "range",
      "label": "Background blur",
      "parent": "appearance",
      "scope": "layer",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1
    },
    {
      "id": "cornerRadius",
      "type": "range",
      "label": "Corner radius",
      "parent": "appearance",
      "scope": "layer",
      "default": 18,
      "min": 0,
      "max": 64,
      "step": 1
    },
    {
      "id": "padding",
      "type": "range",
      "label": "Padding",
      "parent": "appearance",
      "scope": "layer",
      "default": 20,
      "min": 0,
      "max": 80,
      "step": 1
    }
  ]
}
